MONGO_URI=mongodb://mongo:27017
MONGO_DB=noteform
JWT_SECRET=replace-with-a-long-random-string
CORS_ORIGINS=http://localhost:3000
# Optional legacy service-to-service API key. Per-user MCP tokens and OAuth are preferred.
MCP_API_KEY=
MCP_USER_ID=

# Public HTTPS URL used by hosted MCP clients, including the /mcp path.
MCP_PUBLIC_URL=https://your-api.onrender.com/mcp

# SMTP delivery for collaboration invitations
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
# Use a Google App Password when SMTP_HOST=smtp.gmail.com.
SMTP_USE_SSL=false
APP_URL=http://localhost:3000
