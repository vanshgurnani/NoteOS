MONGO_URI=mongodb://mongo:27017
MONGO_DB=noteform
JWT_SECRET=replace-with-a-long-random-string
CORS_ORIGINS=http://localhost:3000
# Optional legacy service-to-service API key. Per-user MCP tokens and OAuth are preferred.
MCP_API_KEY=
MCP_USER_ID=

# Public HTTPS URL used by hosted MCP clients, including the /mcp path.
MCP_PUBLIC_URL=https://your-api.onrender.com/mcp

# Google Identity Services
GOOGLE_CLIENT_ID=

# Private Vercel mailer function
MAILER_API_URL=https://noteos-mailer.vercel.app/api/v1/email/invitations
MAILER_API_KEY=replace-with-a-long-random-secret
APP_URL=http://localhost:3000
